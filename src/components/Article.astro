---
import {getCollection,render,type CollectionEntry} from 'astro:content';
import Base from '../layouts/Base.astro';
import GuideMedia from './GuideMedia.astro';
import ArticleNavigation from './ArticleNavigation.astro';
import {orderedGuides,handbookGroups,guideGroup} from '../data/handbook';
import '../styles/articles.css';
interface Props {entry:CollectionEntry<'guides'|'news'|'history'|'archive'>;category:string;parent:string;parentTitle:string}
const {entry,category,parent,parentTitle}=Astro.props;
const {Content,headings}=await render(entry);
const isGuide=entry.collection==='guides';
const guides=isGuide?orderedGuides(await getCollection('guides')):[];
const index=guides.findIndex(guide=>guide.id===entry.id);
const previous=index>0?guides[index-1]:null;
const next=index>=0?guides[index+1]:null;
const prerequisites:CollectionEntry<'guides'>[]=isGuide?((entry as CollectionEntry<'guides'>).data.prerequisites??[]).map((id:string)=>{const guide=guides.find(guide=>guide.id===id);if(!guide)throw new Error(`Unknown prerequisite ${id} for ${entry.id}`);return guide;}):[];
const contents=headings.filter(heading=>heading.depth===2||heading.depth===3);
const related=isGuide?[]:(await getCollection(entry.collection)).sort((a,b)=>a.data.order-b.data.order);
const groups=isGuide?handbookGroups.map(group=>({title:group.title,active:guideGroup(entry as CollectionEntry<'guides'>)===group.id,items:guides.filter(guide=>guideGroup(guide)===group.id).map(guide=>({title:guide.data.title,href:`/learn/${guide.id}/`,current:guide.id===entry.id}))})).filter(group=>group.items.length):[{title:parentTitle,active:true,items:related.map(item=>({title:item.data.title,href:`${parent}${item.id}/`,current:item.id===entry.id}))}];
const format=isGuide?(entry as CollectionEntry<'guides'>).data.format:'editorial';
const formatLabel=format==='reference'?'Quick reference':format==='profile'?'AI profile':isGuide?'Player handbook':category;
const historical=entry.collection==='history'||entry.collection==='archive';
const hasCollection=isGuide||related.length>1;
---
<Base title={entry.data.title} description={entry.data.description} category={isGuide?'Player handbook':category}>
<div class:list={['article-layout',`article-layout--${format}`,{'article-layout--no-collection':!hasCollection,'article-layout--no-contents':contents.length===0}]}>
{hasCollection&&<aside class="article-rail article-rail--collection" aria-label="Article collection navigation" data-pagefind-ignore><ArticleNavigation groups={groups} parent={parent} label={isGuide?'Handbook navigation':'Collection articles'}/></aside>}
<div class="article-main">
<header class="article-heading">
<a class="article-breadcrumb" href={parent} data-pagefind-ignore>← {isGuide?'Player handbook':parentTitle}</a>
<p class="eyebrow">{formatLabel}</p>
<h1 data-pagefind-meta="title">{entry.data.title}</h1>
<p class="article-description">{entry.data.description}</p>
{entry.data.published&&<p class="article-date"><time datetime={entry.data.published.toISOString()}>{entry.data.published.toLocaleDateString('en',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time></p>}
{historical&&<p class="article-historical"><strong>Historical reading.</strong> Preserve the original context; use the <a href="/learn/">current handbook</a> for today’s game.</p>}
{prerequisites.length>0&&<div class="article-prerequisites" aria-label="Before you start"><strong>Before you start:</strong> {prerequisites.map((guide,i)=><Fragment>{i>0&&<span aria-hidden="true"> · </span>}<a href={`/learn/${guide.id}/`}>{guide.data.title}</a></Fragment>)}</div>}
</header>
<div class="article-mobile-navigation" data-pagefind-ignore>
{hasCollection&&<details class="article-chapter-disclosure"><summary>{isGuide?'Browse handbook':'Browse articles'}</summary><ArticleNavigation groups={groups} parent={parent} label={isGuide?'Browse handbook chapters':'Browse collection articles'}/></details>}
{contents.length>0&&<details class="article-contents-disclosure"><summary>In this article</summary><nav aria-label="On this page"><ol>{contents.map(heading=><li class:list={{'is-subsection':heading.depth===3}}><a data-section-link href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav></details>}
</div>
<article class="prose article-content" data-article-content><GuideMedia><Content/></GuideMedia></article>
{isGuide&&(previous||next)&&<nav class="guide-pagination article-pagination" aria-label="Handbook chapters" data-pagefind-ignore>{previous&&<a class="card" href={`/learn/${previous.id}/`}><span class="eyebrow">Previous chapter</span>{previous.data.title}</a>}{next&&<a class="card" href={`/learn/${next.id}/`}><span class="eyebrow">Next chapter</span>{next.data.title}</a>}</nav>}
{(entry.data.reviewedAgainst||entry.data.sources?.length>0)&&<aside class="article-sources" aria-label="Source references"><h2>Sources &amp; verification</h2>{entry.data.reviewedAgainst&&<p class="article-meta">Reviewed against <a href={`https://github.com/Globulation2/glob2/commit/${entry.data.reviewedAgainst}`}>game revision {entry.data.reviewedAgainst.slice(0,7)}</a>.</p>}{entry.data.sources?.length>0&&<ul>{entry.data.sources.map((source:{title:string,url:string})=><li><a href={source.url}>{source.title} ↗</a></li>)}</ul>}</aside>}
</div>
{contents.length>0&&<aside class="article-rail article-rail--contents" aria-label="Article section navigation" data-pagefind-ignore><nav aria-label="On this page"><h2>On this page</h2><ol>{contents.map(heading=><li class:list={{'is-subsection':heading.depth===3}}><a data-section-link href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol><a class="article-top-link" href="#main">Back to top ↑</a></nav></aside>}
</div>
</Base>
<script>
import '../scripts/article';
</script>
