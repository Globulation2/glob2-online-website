---
import {getCollection,render,type CollectionEntry} from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeading from './PageHeading.astro';
import GuideMedia from './GuideMedia.astro';
import {orderedGuides} from '../data/handbook';
const {entry,category,parent,parentTitle}=Astro.props;
const {Content,headings}=await render(entry);
const isGuide=entry.collection==='guides';
const guides=isGuide?orderedGuides(await getCollection('guides')):[];
const index=guides.findIndex(guide=>guide.id===entry.id);
const previous=index>0?guides[index-1]:null;
const next=index>=0?guides[index+1]:null;
const prerequisites:CollectionEntry<'guides'>[]=isGuide?(entry.data.prerequisites??[]).map((id:string)=>{const guide=guides.find(guide=>guide.id===id);if(!guide)throw new Error(`Unknown prerequisite ${id} for ${entry.id}`);return guide;}):[];
const contents=headings.filter(heading=>heading.depth===2);
---
<Base title={entry.data.title} description={entry.data.description} category={isGuide?'Player handbook':category}>
<div class="page-shell article-shell">
<a class="text-link" href={parent}>← {isGuide?'Player handbook':parentTitle}</a>
<PageHeading title={entry.data.title} description={entry.data.description} eyebrow={isGuide?'Player handbook':category}/>
{prerequisites.length>0&&<aside class="guide-prerequisites" aria-label="Before you start"><p><strong>Before you start</strong></p><ul>{prerequisites.map(guide=><li><a href={`/learn/${guide.id}/`}>{guide.data.title}</a></li>)}</ul></aside>}
{isGuide&&contents.length>1&&<nav class="guide-contents" aria-label="On this page"><h2>On this page</h2><ol>{contents.map(heading=><li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>}
<article class="prose"><GuideMedia><Content/></GuideMedia></article>
{isGuide&&(previous||next)&&<nav class="guide-pagination" aria-label="Handbook chapters">{previous&&<a class="card" href={`/learn/${previous.id}/`}><span class="eyebrow">Previous chapter</span>{previous.data.title}</a>}{next&&<a class="card" href={`/learn/${next.id}/`}><span class="eyebrow">Next chapter</span>{next.data.title}</a>}</nav>}
{entry.data.reviewedAgainst&&<p class="article-meta">Source reference: <a href={`https://github.com/Globulation2/glob2/commit/${entry.data.reviewedAgainst}`}>game revision {entry.data.reviewedAgainst.slice(0,7)}</a>.</p>}
{entry.data.sources?.length>0&&<aside class="sources" aria-label="Source references"><h2>Sources & further reading</h2><ul>{entry.data.sources.map((source:{title:string,url:string})=><li><a href={source.url}>{source.title} ↗</a></li>)}</ul></aside>}
</div>
</Base>
