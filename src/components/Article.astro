---
import {render} from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeading from './PageHeading.astro';
const {entry,category,parent,parentTitle}=Astro.props;
const {Content}=await render(entry);
---
<Base title={entry.data.title} description={entry.data.description} category={category}><div class="page-shell article-shell"><a class="text-link" href={parent}>← {parentTitle}</a><PageHeading title={entry.data.title} description={entry.data.description} eyebrow={category}/><article class="prose"><Content/></article>{entry.data.reviewedAgainst&&<p class="article-meta">Gameplay checked against <a href={`https://github.com/Globulation2/glob2/commit/${entry.data.reviewedAgainst}`}>current source</a>.</p>}{entry.data.sources?.length>0&&<aside class="sources"><h2>Sources & further reading</h2><ul>{entry.data.sources.map((source:{title:string,url:string})=><li><a href={source.url}>{source.title} ↗</a></li>)}</ul></aside>}</div></Base>
