---
import {site} from '../data/site';
import {home} from '../data/marketing';
const {concept='colony'}=Astro.props;
---
<div class:list={['home',{'colony':concept==='colony'}]}>
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-colony" aria-hidden="true">
    <video class="colony-video" data-src="/brand/colony-loop.mp4" poster="/brand/colony-1600.webp" muted loop playsinline preload="none" tabindex="-1"></video>
  </div>
  <button class="colony-motion" type="button" hidden>❚❚ Pause the globs</button>
  <div class="hero-copy">
    <p class="eyebrow">{home.eyebrow}</p>
    <h1 id="hero-title">{home.title}</h1>
    <p class="hero-description">{home.description}</p>
    <div class="actions">
      <a class="button primary big" href={site.appUrl}>{home.playLabel} <span aria-hidden="true">↗</span></a>
      <a class="button big" href={home.firstSession.href}>Learn to play</a>
    </div>
    <p class="hero-note">{home.playNote}</p>
  </div>
</section>
<section class="gameplay-section" aria-labelledby="gameplay-title">
  <figure class="gameplay-image">
    <a href={home.image.src} aria-label="View the first tutorial colony at full size"><img src={home.image.src} width="1280" height="608" alt={home.image.alt} loading="lazy"/></a>
    <figcaption>{home.image.caption}</figcaption>
  </figure>
  <div class="gameplay-copy">
    <h2 id="gameplay-title">{home.gameplayTitle}</h2>
    <p>{home.gameplayDescription}</p>
    <h3>{home.decisionsTitle}</h3>
    <ol class="mechanics-list">{home.decisions.map(decision=><li><h4>{decision.title}</h4><p>{decision.description}</p></li>)}</ol>
  </div>
</section>
<section class="prose section-space" aria-labelledby="first-session-title">
  <div><h2 id="first-session-title">{home.firstSession.title}</h2><p>{home.firstSession.description}</p><a class="text-link" href={home.firstSession.href}>{home.firstSession.label} →</a></div>
</section>
<section class="two-grid" aria-label="Ways to play">{home.playOptions.map(option=><article class="feature"><h2>{option.title}</h2><p>{option.description}</p><a class="text-link" href={option.href}>{option.label} →</a></article>)}</section>
<section class="prose section-space"><h2>{home.background.title}</h2><p>{home.background.description}</p><a class="text-link" href={home.background.href}>{home.background.label} →</a></section>
<section class="closing"><h2>{home.closing.title}</h2><p>{home.closing.description}</p><a class="button primary big" href={site.appUrl}>{home.closing.label} <span aria-hidden="true">↗</span></a></section>
</div>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLVideoElement>('.colony-video').forEach((video) => {
    const hero = video.closest<HTMLElement>('.hero')!;
    const button = hero.querySelector<HTMLButtonElement>('.colony-motion')!;
    let paused = false;
    let visible = false;
    const update = () => {
      button.hidden = reduced.matches || !video.classList.contains('playing');
      video.classList.toggle('still', reduced.matches);
      if (paused || !visible || reduced.matches || document.hidden) video.pause();
      else {
        if (!video.src) video.src = video.dataset.src!;
        void video.play().catch((error: unknown) => {
          // WebKit can cancel a pending play promise when the viewer pauses.
          // That cancellation must preserve the frozen frame and resume button.
          if (error instanceof DOMException && error.name === 'AbortError') return;
          video.classList.remove('playing');
          button.hidden = true;
        });
      }
    };
    video.addEventListener('playing', () => { video.classList.add('playing'); button.hidden = reduced.matches; });
    video.addEventListener('error', () => { video.classList.remove('playing'); button.hidden = true; });
    button.addEventListener('click', () => {
      paused = !paused;
      button.textContent = paused ? '▶ Let the globs roam' : '❚❚ Pause the globs';
      update();
    });
    new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? false;
      update();
    }).observe(hero);
    reduced.addEventListener('change', update);
    document.addEventListener('visibilitychange', update);
    update();
  });
</script>
