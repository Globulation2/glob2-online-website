---
import {getCollection} from 'astro:content';
import {site} from '../data/site';
const {concept='field-guide'}=Astro.props;
const news=(await getCollection('news')).sort((a,b)=>(b.data.published?.getTime()??0)-(a.data.published?.getTime()??0)).slice(0,2);
---
<div class:list={['home',{'colony':concept==='colony'}]}>
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-colony" aria-hidden="true">
    <video class="colony-video" data-src="/brand/colony-loop.mp4" poster="/brand/colony-1600.webp" muted loop playsinline preload="none" tabindex="-1"></video>
  </div>
  <button class="colony-motion" type="button" hidden>❚❚ Pause the globs</button>
  <div class="hero-copy">
    <p class="eyebrow">Small globs. Big plans.</p>
    <h1 id="hero-title">Grow a colony.<br/><span class="accent">Find your strategy.</span></h1>
    <p class="hero-description">A free, open-source real-time strategy game where you assign tasks and your globs get to work.</p>
    <div class="actions">
      <a class="button primary big" href={site.appUrl}>Play in browser <span aria-hidden="true">↗</span></a>
      <a class="button big" href="/downloads/">Download the game</a>
    </div>
    <p class="hero-note">Browser early access on computers and phones · Rooms with friends, quick matches, leaderboards and shared maps at <a href={site.hubUrl}>app.glob2online.com</a></p>
  </div>
</section>
<figure class="hero-scene"><img src="/images/globulation2-match.webp" width="1000" height="562" alt="Globulation 2 match with turquoise globs, organic buildings, purple flags and resource paths across green terrain" fetchpriority="high"/><figcaption>Meet your colony. Every glob has a job to do.</figcaption></figure>
<section class="intro"><p class="eyebrow">A different kind of RTS</p><h2>Think in tasks.<br/>Watch a world come alive.</h2><p>Choose what needs doing, then let your globs handle the details. Shape an economy, train your colony, and decide where to push next.</p></section>
<section class="three-grid" aria-label="How you play">
  <article class="feature"><img src="/brand/swarm.webp" width="56" height="56" alt=""/><span class="number">01 / GROW</span><h3>Keep your colony thriving.</h3><p>Build inns, gather food, and balance the workers behind every new building.</p></article>
  <article class="feature"><img src="/brand/exploration-flag.webp" width="56" height="56" alt=""/><span class="number">02 / PLAN</span><h3>Give direction, not every order.</h3><p>Assign workers and place flags. Your globs find their way to the work.</p></article>
  <article class="feature"><img src="/brand/war-flag.webp" width="56" height="56" alt=""/><span class="number">03 / ADAPT</span><h3>Make the map your own.</h3><p>Explore, train, and choose where your colony should defend or advance.</p></article>
</section>
<section class="split-section"><div><p class="eyebrow">Your first colony starts here</p><h2>New to the world?</h2><p>Learn the rhythm of food, construction, and training before your first multiplayer match.</p><a class="text-link" href="/learn/">Open the player’s field guide →</a></div><div class="callout"><span class="eyebrow">Play online</span><h3>Climb the ladder.<br/>Share your maps.</h3><p>Ranked and casual matches, leaderboards, match replays and a catalog of player-made maps live in the online app.</p><p class="callout-links"><a class="text-link" href={site.leaderboardUrl}>Leaderboards ↗</a> <a class="text-link" href={site.mapsUrl}>Maps ↗</a> <a class="text-link" href="/community/">Community →</a></p></div></section>
<section class="news-section"><div class="section-heading"><div><p class="eyebrow">From the project</p><h2>News & notes</h2></div><a class="text-link" href="/news/">All news →</a></div><div class="two-grid">{news.map(item=><a class="card" href={`/news/${item.id}/`}><span class="eyebrow">{item.data.published?.toLocaleDateString('en',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})??'Project update'}</span><h3>{item.data.title}</h3><p>{item.data.description}</p><span class="text-link">Read the story →</span></a>)}</div></section>
<section class="closing"><p class="eyebrow">Your next move</p><h2>Let the globs get to work.</h2><a class="button primary big" href={site.appUrl}>Play in browser <span aria-hidden="true">↗</span></a><a class="text-link" href="/game/">Get to know the game →</a></section>
</div>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLVideoElement>('.colony-video').forEach((video) => {
    const hero = video.closest<HTMLElement>('.hero')!;
    const button = hero.querySelector<HTMLButtonElement>('.colony-motion')!;
    let paused = false;
    let visible = false;
    const update = () => {
      button.hidden = reduced.matches || !video.classList.contains('playing');
      video.classList.toggle('still', reduced.matches);
      if (paused || !visible || reduced.matches || document.hidden) video.pause();
      else {
        if (!video.src) video.src = video.dataset.src!;
        void video.play().catch(() => { video.classList.remove('playing'); button.hidden = true; });
      }
    };
    video.addEventListener('playing', () => { video.classList.add('playing'); button.hidden = reduced.matches; });
    video.addEventListener('error', () => { video.classList.remove('playing'); button.hidden = true; });
    button.addEventListener('click', () => {
      paused = !paused;
      button.textContent = paused ? '▶ Let the globs roam' : '❚❚ Pause the globs';
      update();
    });
    new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? false;
      update();
    }).observe(hero);
    reduced.addEventListener('change', update);
    document.addEventListener('visibilitychange', update);
    update();
  });
</script>
