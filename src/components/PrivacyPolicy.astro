---
import {render, type CollectionEntry} from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeading from './PageHeading.astro';
const {entry} = Astro.props as {entry: CollectionEntry<'legal'>};
const {Content, headings} = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description} category={entry.id === 'terms' ? 'Terms' : 'Privacy'}>
  <div class="page-shell article-shell">
    <PageHeading title={entry.data.title} description={entry.data.description} eyebrow={entry.id === 'terms' ? 'Terms and conditions' : 'Privacy'}/>
    <nav class="guide-contents" aria-label="On this page">
      <h2>On this page</h2>
      <ul>
        {headings.filter(heading => heading.depth === 2).map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
      </ul>
    </nav>
    <article class="prose legal-policy"><Content/></article>
    {entry.id === 'privacy' && <section class="prose" aria-labelledby="theme-preference">
      <h2 id="theme-preference">Website theme preference</h2>
      <p>The light, dark, or device theme choice uses a functional <code>glob2-theme</code> cookie shared with app.glob2online.com. It lasts for one year and contains only that preference, without an account identifier. Localhost and unrelated preview sites use browser-local storage instead. You can return to the device theme with the theme control.</p>
    </section>}
    <aside class="sources" aria-label="Policy source">
      <h2>Policy source</h2>
      <p>This document is maintained in the <a href={entry.data.sourceUrl}>Globulation 2 game repository</a>. The website copy is synchronized with the game repository.</p>
    </aside>
  </div>
</Base>
<style>
  .legal-policy { overflow-wrap: anywhere; }
  .legal-policy :global(table) { width: 100%; table-layout: fixed; }
  .legal-policy :global(th), .legal-policy :global(td) { min-width: 0; overflow-wrap: anywhere; }
</style>
