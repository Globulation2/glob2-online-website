---

import { localizedMarketing, translate, localizedPath, englishLabel, type Locale } from '../i18n';
const {locale='en'}=Astro.props as {locale?:Locale};
const {game}=localizedMarketing(locale);
const t=(key:Parameters<typeof translate>[1], params:Record<string,string|number>={})=>translate(locale,key,params);
const english=(label:string)=>englishLabel(locale,label);
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import {site} from '../data/site';
import {getGameLabel} from '../data/storefronts';
import {currentGameplayShots,currentGameplayNote} from '../data/artwork';
const image=currentGameplayShots[0];

---
<Base locale={locale} title={t('ui.game')} description={game.description}><div class="page-shell">
<PageHeading eyebrow={t('ui.game')} title={game.title} description={game.description}/>
<figure class="wide-scene gameplay-image"><a href={image.src} aria-label={t('game.fullImage')}><img src={image.src} width={image.width} height={image.height} alt={english(image.alt)} lang="en"/></a><figcaption lang="en" dir="ltr">{english(image.caption)} {currentGameplayNote} A paused replay view.</figcaption></figure>
<div class="prose">{game.sections.map(section=><section><h2>{section.title}</h2>{section.paragraphs.map(paragraph=><p>{paragraph}</p>)}</section>)}</div>
<section class="section-space" aria-labelledby="roles-title"><h2 id="roles-title">{t('game.rolesTitle')}</h2><div class="three-grid">{game.roles.map(role=><article class="feature"><h3>{role.title}</h3><p>{role.description}</p></article>)}</div></section>
<section class="section-space"><h2>{t('game.startTitle')}</h2><div class="actions"><a class="btn primary" href={localizedPath(locale,'downloads')}>{getGameLabel(locale,t('game.downloads'))}</a><a class="btn secondary" href={site.appUrl}>{t('game.play')} ↗</a><a class="text-link" href="/learn/getting-started/">{english(t('game.guide'))}</a></div></section>
</div></Base>
