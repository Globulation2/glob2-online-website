---
import '../styles/site.css';
import {site} from '../data/site';
interface Props {title:string; description?:string; category?:string; noindex?:boolean}
const {title,description=site.tagline,category,noindex=false}=Astro.props;
const pageTitle=title===site.name?site.name:`${title} · ${site.name}`;
const nav=[['The game','/game/'],['Learn','/learn/'],['Community','/community/'],['Competition','/competition/'],['News','/news/']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{pageTitle}</title><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:title" content={pageTitle}/><meta property="og:site_name" content={site.name}/><meta property="og:description" content={description}/><meta property="og:image" content="https://glob2online.com/images/globulation2-match.png"/><meta name="theme-color" content="#214c38"/>{noindex&&<meta name="robots" content="noindex"/>}</head><body>
<a class="skip" href="#main" tabindex="0">Skip to content</a><header class="site-header" data-pagefind-ignore><a class="brand" href="/" aria-label={`${site.name} home`}><img src="/favicon.svg" width="36" height="36" alt=""/><span class="brand-wordmark"><span>Globulation<span class="brand-two"> 2</span></span><span class="brand-online">Online</span></span></a><nav aria-label="Main navigation">{nav.map(([label,url])=><a href={url} aria-current={Astro.url.pathname.startsWith(url)?'page':undefined}>{label}</a>)}<a href="/search/" aria-label="Search the website">Search</a></nav><a class="header-play" href={site.appUrl}>Play ↗</a></header>
<main id="main" tabindex="-1" data-pagefind-body={!noindex?true:undefined} data-pagefind-ignore={noindex?true:undefined}>{category&&<span hidden data-pagefind-filter="type">{category}</span>}<slot/></main>
<footer class="site-footer" data-pagefind-ignore><div><a class="brand" href="/" aria-label={`${site.name} home`}><span class="brand-wordmark"><span>Globulation<span class="brand-two"> 2</span></span><span class="brand-online">Online</span></span></a><p>A little less clicking.<br/>A lot more strategy.</p></div><div><strong>Explore</strong><a href="/downloads/">Downloads</a><a href="/learn/">Player guides</a><a href="/history/">Our history</a><a href="/archive/">Legacy archive</a><a href="/privacy/">Privacy</a></div><div><strong>Get involved</strong><a href={site.sourceUrl}>Source & contributions ↗</a><a href="/community/">Community</a><a href={site.loginUrl}>Multiplayer login ↗</a></div><p class="footer-note">Free software. Built by a community.<br/>Website artwork comes from the Globulation 2 project. <a href="/credits/">Credits & sources</a></p></footer>
</body></html>
