---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import {site} from '../data/site';
import {community} from '../data/marketing';
---
<Base title="Community" description={community.description}><div class="page-shell"><PageHeading eyebrow="Community" title={community.title} description={community.description}/>
<section class="prose section-space"><h2>Join our Discord</h2><p>{community.discordDescription}</p><a class="button" href={site.discordUrl}>Join the community server ↗</a></section>
<div class="two-grid section-space">
<article class="feature"><h2>{community.contributionTitle}</h2><p>{community.contributionDescription}</p><a class="text-link" href={site.sourceUrl}>Visit the project repository ↗</a></article>
<article class="feature"><h2>{community.bugTitle}</h2><p>{community.bugDescription}</p><a class="text-link" href={`${site.sourceUrl}/issues`}>Open the issue tracker ↗</a></article>
<article class="feature"><h2>{community.mapsTitle}</h2><p>{community.mapsDescription}</p><a class="text-link" href={site.mapsUrl}>Browse maps in the online app ↗</a></article>
<article class="feature"><h2>{community.historyTitle}</h2><p>{community.historyDescription}</p><a class="text-link" href="https://globulation2.org/wiki/Main_Page">Explore the original wiki ↗</a></article>
</div>
</div></Base>
