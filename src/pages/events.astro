---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import {events} from '../data/site';
---
<Base title="Community events"><div class="page-shell"><PageHeading title="Community events" eyebrow="Gather around a good game" description="Confirmed community tournaments, their rules, schedules and results."/>{events.length?events.map(event=><article id={event.slug} class="card"><p class="eyebrow">{event.status}</p><h2>{event.title}</h2><p>{new Date(event.start).toLocaleString('en',{timeZone:event.timezone})} ({event.timezone})</p>{event.end&&<p>Ends {new Date(event.end).toLocaleString('en',{timeZone:event.timezone})} ({event.timezone})</p>}<p>{event.format} · Organized by {event.organizer}</p><h3>Rules</h3><ul>{event.rules.map(rule=><li>{rule}</li>)}</ul>{event.registrationUrl&&['announced','registration-open'].includes(event.status)&&<a href={event.registrationUrl}>Registration ↗</a>}{event.results&&<><h3>Results</h3><ol>{event.results.map(result=><li>{result.place}. {result.player}</li>)}</ol></>}</article>):<div class="empty-state"><h2>No scheduled events yet.</h2><p>Once an organizer confirms an event, its format, timezone, rules, and registration details will be published here.</p><a class="text-link" href="/community/">Visit the community →</a></div>}</div></Base>
