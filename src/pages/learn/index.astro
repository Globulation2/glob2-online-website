---
import {getCollection} from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import {handbookGroups,guideGroup,orderedGuides} from '../../data/handbook';
const guides=orderedGuides(await getCollection('guides'));
const groups=handbookGroups.map(group=>({...group,guides:guides.filter(guide=>guideGroup(guide)===group.id)})).filter(group=>group.guides.length>0);
const start=guides.find(guide=>guide.id==='getting-started');
---
<Base title="The player handbook." category="Player handbook"><div class="page-shell handbook-shell">
<PageHeading title="The player handbook." description="Learn to run a colony, understand its needs, and choose your next move."/>
{start&&<section class="callout handbook-start" aria-labelledby="handbook-start"><span class="eyebrow">Begin here</span><h2 id="handbook-start">Your first colony</h2><p>Start with food, workers, and exploration. Then follow the chapters through colony management, development, and defense.</p><a class="text-link" href={`/learn/${start.id}/`}>Read {start.data.title} →</a></section>}
<nav class="handbook-sections" aria-label="Handbook sections">{groups.map(group=><a href={`#${group.id}`}>{group.title}</a>)}</nav>
{groups.map(group=><section class="section-space handbook-group" aria-labelledby={group.id}><div class="section-heading"><h2 id={group.id}>{group.title}</h2></div><p class="handbook-group-description">{group.description}</p><div class="two-grid">{group.guides.map(guide=><a class="card" href={`/learn/${guide.id}/`}><h3>{guide.data.title}</h3><p>{guide.data.description}</p><span class="text-link">Read chapter →</span></a>)}</div></section>)}
</div></Base>
