---
import {getCollection} from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import {handbookGroups,guideGroup,orderedGuides} from '../../data/handbook';
import '../../styles/discovery.css';
const guides=orderedGuides(await getCollection('guides'));
const groups=handbookGroups.map(group=>({...group,guides:guides.filter(guide=>guideGroup(guide)===group.id)})).filter(group=>group.guides.length>0);
const start=guides.find(guide=>guide.id==='getting-started');
const reference=groups.find(group=>group.id==='reference');
---
<Base title="The player handbook." category="Player handbook"><div class="page-shell discovery-shell handbook-shell">
<PageHeading title="The player handbook." eyebrow="Learn to play" description="Learn to run a colony, understand its needs, and choose your next move."/>
<div class="handbook-entrypoints">
{start&&<section class="handbook-start discovery-panel" aria-labelledby="handbook-start"><span class="eyebrow">Begin here</span><h2 id="handbook-start">Your first colony</h2><p>Start with food, workers, and exploration. Then follow the chapters through colony management, development, and defense.</p><a class="text-link" href={`/learn/${start.id}/`}>Read {start.data.title} →</a></section>}
{reference&&<nav class="discovery-panel handbook-lookup" aria-labelledby="handbook-lookup" data-pagefind-ignore><span class="eyebrow">Find an answer</span><h2 id="handbook-lookup">Quick reference</h2><ul>{reference.guides.map(guide=><li><a href={`/learn/${guide.id}/`}>{guide.data.title}<span aria-hidden="true"> →</span></a></li>)}</ul><a class="text-link" href="/search/">Search the handbook →</a></nav>}
</div>
<nav class="handbook-sections" aria-label="Handbook sections" data-pagefind-ignore>{groups.map(group=><a href={`#${group.id}`}>{group.title}</a>)}</nav>
{groups.map(group=><section class="section-space handbook-group" aria-labelledby={group.id}><div class="section-heading"><h2 id={group.id}>{group.title}</h2></div><p class="handbook-group-description">{group.description}</p><div class="discovery-grid">{group.guides.map(guide=><a class="card discovery-card" href={`/learn/${guide.id}/`}><span class="eyebrow">{group.id==='reference'?'Reference':group.id==='ai'?'AI guide':'Chapter'}</span><h3>{guide.data.title}</h3><p>{guide.data.description}</p><span class="text-link">Read chapter →</span></a>)}</div></section>)}
</div></Base>
