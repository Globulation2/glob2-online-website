---
import {getCollection} from 'astro:content';
import Article from '../../components/Article.astro';
export async function getStaticPaths() {return (await getCollection('archive')).map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props;
---
<Article entry={entry} category="Historical" parent="/archive/" parentTitle="Keep the old paths open."/>
