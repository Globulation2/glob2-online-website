---
import {getCollection} from 'astro:content';
import Article from '../../components/Article.astro';
export async function getStaticPaths() {return (await getCollection('history')).map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props;
---
<Article entry={entry} category="Historical" parent="/history/" parentTitle="A world with a history."/>
