---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import {site} from '../data/site';
import {game,home} from '../data/marketing';
---
<Base title="The game" description={game.description}><div class="page-shell">
<PageHeading eyebrow="The game" title={game.title} description={game.description}/>
<figure class="wide-scene gameplay-image"><a href={home.image.src} aria-label="View the first tutorial colony at full size"><img src={home.image.src} width="1280" height="608" alt={home.image.alt}/></a><figcaption>{home.image.caption}</figcaption></figure>
<div class="prose">{game.sections.map(section=><section><h2>{section.title}</h2>{section.paragraphs.map(paragraph=><p>{paragraph}</p>)}</section>)}</div>
<section class="section-space" aria-labelledby="roles-title"><h2 id="roles-title">Three kinds of glob</h2><div class="three-grid">{game.roles.map(role=><article class="feature"><h3>{role.title}</h3><p>{role.description}</p></article>)}</div></section>
<section class="section-space"><h2>Start with the tutorial</h2><div class="actions"><a class="button" href={site.appUrl}>Play in browser ↗</a><a class="button secondary" href="/learn/getting-started/">Read the first-session guide</a><a class="text-link" href="/downloads/">Downloads and source →</a></div></section>
</div></Base>
