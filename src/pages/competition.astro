---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import Rankings from '../components/Rankings.astro';
import {events} from '../data/site';
---
<Base title="Competition"><div class="page-shell"><PageHeading eyebrow="Play together. Improve together." title="Every match is a new lesson." description="Online player ratings and community tournament announcements, in one place."/><Rankings/><section class="section-space"><div class="section-heading"><h2>Community tournaments</h2><a class="text-link" href="/events/">Event details →</a></div>{events.length?<div class="two-grid">{events.map(event=><a class="card" href={`/events/#${event.slug}`}><span class="eyebrow">{event.status}</span><h3>{event.title}</h3><p>{event.format}</p></a>)}</div>:<div class="empty-state"><h3>No announced tournaments yet.</h3><p>Confirmed schedules, rules and results will appear here when organizers publish an event.</p><a class="text-link" href="/community/">Connect with the community →</a></div>}</section></div></Base>
