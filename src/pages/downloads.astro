---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import { publishedReleaseMetadata, site } from '../data/site';
import { channelsSchema } from '../data/downloads-schema';
import { downloadPlatforms as platforms, downloadArchitectures as architectures, downloadFormats as labels } from '../data/downloads';
import { downloads } from '../data/marketing';
import channelData from '../data/download-channels.json';
import type { DownloadPackage } from '../data/downloads-schema';
const manifest = publishedReleaseMetadata.manifest;
const channels = channelsSchema.parse(channelData);
if (channels.releaseTag && channels.releaseTag !== manifest?.tag) throw new Error('Reviewed channel updates must match the current release tag');
const googlePlay = channels.withdrawnStores.includes('googlePlay') ? null : (channels.googlePlay ?? manifest?.qualification.stores.googlePlay);
const appStore = channels.withdrawnStores.includes('appStore') ? null : (channels.appStore ?? manifest?.qualification.stores.appStore);
const architectureLabel = (pkg: DownloadPackage) => pkg.platform === 'macos' ? (pkg.architecture === 'arm64' ? 'Apple Silicon' : 'Intel') : architectures[pkg.architecture];
const packagesFor = (platform: typeof platforms[number]) => (manifest?.packages ?? []).filter(pkg => pkg.platform === platform.id && !channels.withdrawnPackages.includes(pkg.filename)).sort((a, b) => platform.formats.indexOf(a.format) - platform.formats.indexOf(b.format) || (a.architecture === 'arm64' ? -1 : b.architecture === 'arm64' ? 1 : a.architecture.localeCompare(b.architecture)));
const size = (bytes: number) => `${(bytes / 1024 / 1024).toFixed(1)} MiB`;
---
<Base title="Downloads" description={downloads.description}>
  <div class="page-shell">
    <PageHeading eyebrow="Downloads" title={downloads.title} description={downloads.description} />
    <section class="card download-browser" aria-labelledby="browser-heading">
      <div><p class="eyebrow">No installation</p><h2 id="browser-heading">{downloads.browserTitle}</h2><p>{downloads.browserDescription}</p></div>
      <a class="button" href={site.appUrl}>{downloads.browserLabel} ↗</a>
    </section>
    <section class="download-release section-space" aria-labelledby="release-heading">
      <h2 id="release-heading">{manifest ? `Release ${manifest.version}` : 'Installed editions'}</h2>
      {manifest ? <p>All packages below come from the same qualified release. <a href={manifest.releaseNotesUrl}>Read release notes ↗</a></p> : <p>A verified all-platform release is not published here yet. Use the browser app, or visit the source repository for build instructions.</p>}
    </section>
    <div class="two-grid download-platforms">
      {platforms.map(platform => {
        const packages = packagesFor(platform);
        return <section class="card download-platform" aria-labelledby={`${platform.id}-heading`}>
          <h2 id={`${platform.id}-heading`}>{platform.title}</h2>
          {packages.length ? <>
            <p>{platform.description}</p>
            {platform.id === 'android' && googlePlay && <a class="button" href={googlePlay.url}>Get it on Google Play ↗</a>}
            <ul class="download-packages">
              {packages.map((pkg, index) => <li>
                <h3>{labels[pkg.format]} · {architectureLabel(pkg)}</h3>
                <p class="download-meta">Version {manifest!.version} · {size(pkg.sizeBytes)}<br />Requires {pkg.minimumOs}</p>
                <a class={index === 0 && platform.id !== 'android' ? 'button' : 'text-link'} href={pkg.url}>Download {platform.title} {labels[pkg.format]} — {architectureLabel(pkg)} ↗</a>
                {pkg.dependencies?.length && <p class="download-meta">Dependencies: {pkg.dependencies.join(', ')}</p>}
                <details class="download-checksum"><summary>SHA-256 · {labels[pkg.format]} · {architectureLabel(pkg)}</summary><code>{pkg.sha256}</code></details>
              </li>)}
            </ul>
            <details class="download-help"><summary>How to install on {platform.title}</summary><p>{platform.help}</p></details>
          </> : <p class="download-unavailable">No verified {platform.title} download is currently listed.</p>}
        </section>;
      })}
      <section class="card download-platform" aria-labelledby="ios-heading">
        <h2 id="ios-heading">iPhone &amp; iPad</h2>
        {appStore ? <><p>Install the production edition from the App Store. Check the listing for supported devices and OS requirements.</p><a class="button" href={appStore.url}>Download on the App Store ↗</a></> : <p class="download-unavailable">No verified production App Store release is currently listed.</p>}
      </section>
      <section class="card download-platform" aria-labelledby="source-heading">
        <h2 id="source-heading">Source code</h2><p>{downloads.sourceDescription}</p><a class="text-link" href={site.sourceUrl}>Browse source and build instructions ↗</a><p class="download-meta"><a href="https://github.com/Globulation2/glob2/releases">Check releases ↗</a></p>
        {manifest && <ul class="download-packages">{manifest.sources.map(source => <li><a href={source.url}>Download source archive · {size(source.sizeBytes)} ↗</a><details class="download-checksum"><summary>Source SHA-256</summary><code>{source.sha256}</code></details></li>)}</ul>}
      </section>
    </div>
    <section class="prose section-space"><h2>{downloads.helpTitle}</h2><p>{downloads.helpDescription}</p><a href="/learn/getting-started/">Read the first-session guide →</a></section>
  </div>
</Base>
<style>
  .download-browser {display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--sp-5);}
  .download-platforms {align-items: stretch;}
  .download-platform {min-width: 0;}
  .download-packages {list-style: none; padding: 0; margin: var(--sp-5) 0;}
  .download-packages li + li {border-top: 1px solid var(--line); padding-top: var(--sp-5); margin-top: var(--sp-5);}
  .download-packages h3 {font-size: 1.15rem;}
  .download-meta {font-size: var(--text-sm); color: var(--ink-2); margin: var(--sp-3) 0;}
  .download-checksum {margin-top: var(--sp-3);}
  summary {cursor: pointer; min-height: var(--target); padding: var(--sp-2) 0; text-decoration: underline; text-underline-offset: 3px;}
  .download-checksum code {display: block; overflow-wrap: anywhere; margin: var(--sp-2) 0;}
  .download-help p {margin: var(--sp-3) 0 0;}
  .download-unavailable {color: var(--ink-2);}
</style>
