---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import {releases,site} from '../data/site';
---
<Base title="Downloads"><div class="page-shell"><PageHeading eyebrow="Play your way" title="Make room for your colony." description="Find published builds and source code, or open the browser app."/><div class="two-grid"><article class="card"><h2>Browser early access</h2><p>The browser app opens separately. Availability depends on the current browser release.</p><a class="button" href={site.appUrl}>Open browser app ↗</a></article>{releases.map(release=><article class="card"><p class="eyebrow">{release.platform}</p><h2>{release.title}</h2>{release.version&&<p>Version {release.version}</p>}<p>{release.status==='source'?'Build the game from source with the repository’s platform instructions.':release.status==='release-index'?'Check the release page for desktop packages. New downloads appear here as releases are published.':'See the published release for installation instructions and available files.'}</p><a class="text-link" href={release.url}>{release.status==='source'?'Get source code':release.status==='release-index'?'Check releases':'View release'} ↗</a></article>)}</div><section class="prose section-space"><h2>Getting started</h2><p>Run the in-game tutorial first. If you need help with food, construction, or multiplayer, the player guides are a good next step.</p><a href="/learn/">Read the beginner guides →</a></section></div></Base>
