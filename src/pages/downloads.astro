---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import {releases,site} from '../data/site';
import {downloads} from '../data/marketing';
---
<Base title="Downloads" description={downloads.description}><div class="page-shell"><PageHeading eyebrow="Downloads" title={downloads.title} description={downloads.description}/>
<div class="two-grid"><article class="card"><h2>{downloads.browserTitle}</h2><p>{downloads.browserDescription}</p><a class="button" href={site.appUrl}>{downloads.browserLabel} ↗</a></article>{releases.map(release=><article class="card"><p class="eyebrow">{release.platform}</p><h2>{release.title}</h2>{release.version&&<p>Version {release.version}</p>}<p>{release.status==='source'?downloads.sourceDescription:release.status==='release-index'?'No verified desktop installer is listed here. Check the project’s releases for published packages.':'See the published release for installation instructions and available files.'}</p><a class="text-link" href={release.url}>{release.status==='source'?'Get source code':release.status==='release-index'?'Check releases':'View release'} ↗</a></article>)}</div>
<section class="prose section-space"><h2>{downloads.helpTitle}</h2><p>{downloads.helpDescription}</p><a href="/learn/getting-started/">Read the first-session guide →</a></section>
</div></Base>
