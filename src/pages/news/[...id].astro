---
import {getCollection} from 'astro:content';
import Article from '../../components/Article.astro';
export async function getStaticPaths() {return (await getCollection('news')).map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props;
---
<Article entry={entry} category="Project news" parent="/news/" parentTitle="News & notes."/>
